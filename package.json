    "react-dom": "^19.1.1",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^10.0.5",
    "vite": "^7.1.7"
  }
