DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
JWT_SECRET=replace-with-at-least-32-random-characters
MANAGER_SIGNUP_CODE=replace-with-a-private-manager-registration-code
AUTH_DEBUG=false
CLIENT_ORIGIN=http://localhost:5173
PORT=3001
SCREENSHOT_BUCKET=prematch-screenshots
AWS_ACCESS_KEY_ID=replace-with-neon-storage-access-key
AWS_SECRET_ACCESS_KEY=replace-with-neon-storage-secret-key
AWS_ENDPOINT_URL_S3=https://replace-with-your-branch-storage-endpoint
AWS_REGION=ap-southeast-1
