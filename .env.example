VITE_API_URL=http://localhost:3001
VITE_SOCKET_URL=http://localhost:3001

# Optional local backend overrides used only by `npm run dev`.
# Prefer a disposable Neon development branch instead of the production URL.
LOCAL_DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
JWT_SECRET=prematch-local-development-jwt-secret-2026
MANAGER_SIGNUP_CODE=LOCAL-MANAGER-CODE
AUTH_DEBUG=false
CLIENT_ORIGIN=http://localhost:5173
PORT=3001
SCREENSHOT_BUCKET=prematch-screenshots
AWS_ACCESS_KEY_ID=replace-with-neon-storage-access-key
AWS_SECRET_ACCESS_KEY=replace-with-neon-storage-secret-key
AWS_ENDPOINT_URL_S3=https://replace-with-your-branch-storage-endpoint
AWS_REGION=ap-southeast-1
